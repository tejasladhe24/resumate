{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "start": "node --env-file=.env dist/index.js",
    "build": "tsup",
    "dev": "tsup --watch & nodemon --watch dist --ext js --exec node --env-file=.env dist/index.js",
    "clean": "rm -rf dist node_modules .turbo dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1037.0",
    "@aws-sdk/s3-request-presigner": "^3.1037.0",
    "@workspace/pgdb": "workspace:*",
    "@workspace/mongodb": "workspace:*",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "express": "^5.1.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "inngest": "^4.2.4",
    "jose": "^6.2.2",
    "morgan": "^1.10.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.19.9",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "dotenv": "^17.2.3",
    "eslint": "^9.32.0",
    "nodemon": "^3.1.14",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
